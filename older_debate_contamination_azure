class ContentFilterError(Exception):
    """Raised when Azure blocks a model response."""


class ChatAzure:
    """
    Azure AI Foundry "Models inference endpoint" chat wrapper.

    Unified endpoint format (host ends in .services.ai.azure.com) -- ONE url
    per resource, with the model selected via the "model" field in the JSON
    body rather than a deployment name baked into the URL path. Using the
    older classic Azure OpenAI URL shape (deployment name in the path) against
    a .services.ai.azure.com host returns a 401/403, since it's simply the
    wrong route for this resource type, not (only) a real permissions problem.
    """

    def __init__(self, endpoint: str, api_key: str, model: str, temperature: float = 0, max_retries: int = 2):
        self.endpoint = endpoint.rstrip("/")
        self.api_key = api_key
        self.model = model
        self.temperature = temperature
        self.max_retries = max_retries

    def invoke(self, messages):
        payload = {
            "model": self.model,
            "messages": [
                {"role": "user" if role == "human" else role, "content": text}
                for role, text in messages
            ],
            "temperature": self.temperature,
        }
        # One URL per resource -- the deployment/model is selected via the
        # "model" field in the payload above, not a URL path segment.
        url = f"{self.endpoint}/models/chat/completions?api-version=2024-05-01-preview"
        headers = {"api-key": self.api_key, "Content-Type": "application/json"}
        last_exc = None

        for attempt in range(1, self.max_retries + 1):
            try:
                response = requests.post(url, headers=headers, json=payload, timeout=30)
                response.raise_for_status()
                body = response.json()
                choice = body.get("choices", [{}])[0]
                if choice.get("finish_reason") == "content_filter" or choice.get("content_filter_results"):
                    raise ContentFilterError(choice.get("content_filter_results") or body)
                if "usage" in body:
                    print(f"[ChatAzure] usage: {body['usage']}")
                return SimpleNamespace(content=choice.get("message", {}).get("content", ""))
            except HTTPError as error:
                last_exc = error
                status = getattr(error.response, "status_code", None)
                if status in (429, 500, 502, 503, 504) and attempt < self.max_retries:
                    time.sleep(min(2**attempt, 30))
                    continue
                raise
            except ContentFilterError:
                raise
            except Exception as error:  # network failures only get a bounded retry
                last_exc = error
                if attempt < self.max_retries:
                    time.sleep(1)
                    continue
                raise
        raise last_exc


NEUTRAL_ROLE = (
    "You are an agent in a debate about solving this task. You are thoughtful, "
    "analytical, and open to changing your mind when presented with compelling "
    "evidence."
)
TASK_DISCIPLINE = (
    "Choose the most likely intended answer under ordinary language use and the "
    "information given. Do not invent unstated scenarios, demand logical certainty, "
    "or reject a normally answerable benchmark item merely because another reading "
    "is theoretically possible."
)


@dataclass
class Agent:
    name: str
    llm: object = field(repr=False)

    def speak(self, prompt_text: str, transcript: str, valid_options: list[str], turn: int, private_context: str | None = None) -> str:
        extra = f"\nYou have this extra information: {private_context}\n" if private_context else ""
        options = "|".join(valid_options)
        system = (
            f"{NEUTRAL_ROLE}\n{TASK_DISCIPLINE}\n\n"
            f"Task:\n{prompt_text}\n{extra}\n"
            "Carefully analyze the task, respond to relevant prior arguments, and give "
            "a concise grounded rationale. Do not merely agree with another agent. "
            f"End with exactly: ANSWER: {options} (replace the options with one choice)."
        )
        user = transcript if transcript else "No prior arguments. Solve the task."
        return self.llm.invoke([("system", system), ("human", user)]).content.strip()

    def vote(self, prompt_text: str, transcript: str, valid_options: list[str]) -> tuple[str, str]:
        options = "|".join(valid_options)
        system = (
            f"{NEUTRAL_ROLE}\n{TASK_DISCIPLINE}\n\nTask:\n{prompt_text}\n\n"
            "The debate is over. Independently select the best-supported answer, not a "
            "mere consensus position. Respond with exactly two lines:\n"
            f"VOTE: {options}\nREASON: <one brief grounded sentence>"
        )
        content = self.llm.invoke([("system", system), ("human", transcript)]).content.strip()
        return parse_vote(content, valid_options)


@dataclass
class DebateResult:
    winner: str
    source_agent_index: int | None
    source_initial_answer: str | None
    source_final_vote: str | None
    source_recovered: bool | None
    adjacent_answer_matches: int
    adjacent_answer_comparisons: int


def build_agents() -> list[Agent]:
    return [
        Agent(
            name=f"Agent {index + 1}",
            llm=ChatAzure(AZURE_ENDPOINT, AZURE_API_KEY, AZURE_MODEL, TEMPERATURE),
        )
        for index in range(NUM_AGENTS)
    ]


def _answer_options(valid_options: list[str]) -> list[str]:
    """MINT MCQs always require a choice; ABSTAIN is not a valid experimental vote."""
    return [option for option in valid_options if option != "ABSTAIN"]


def _extract_answer(statement: str, valid_options: list[str], option_texts: dict[str, str] | None) -> str | None:
    answer, _ = parse_vote(statement, valid_options, option_texts)
    return None if answer == "ABSTAIN" else answer


def _condition_context(item: Question, condition: str, questions: list[Question] | None = None, item_index: int = 0) -> str | None:
    if condition == "clean":
        return None
    if condition == "relevant_misinformation":
        # Always the dataset's literal "other" entry inside misinformation_by_strategy,
        # taken verbatim. Hardcoded to "other" (not MISINFORMATION_STRATEGY) so there is
        # no path by which a config edit elsewhere could silently change what's injected.
        return get_contamination_context(item, strategy="other")
    if condition == "irrelevant_true_information":
        if isinstance(item, dict):
            context = item.get("irrelevant_true_information")
            if isinstance(context, str) and context.strip():
                return context
        raise ValueError("This item has no irrelevant_true_information control. Use MINT via the 'mint' batch option.")
    if condition == "irrelevant_misinformation":
        if not questions or len(questions) < 2:
            raise ValueError("Irrelevant-misinformation control requires a batch with at least two MINT items.")
        # Deterministic derangement: each item receives another item's literal "other" text.
        digest = hashlib.sha256(f"{config.RANDOM_SEED}:{item_index}".encode()).digest()
        offset = 1 + int.from_bytes(digest[:4], "big") % (len(questions) - 1)
        other = questions[(item_index + offset) % len(questions)]
        return get_contamination_context(other, strategy="other")
    raise ValueError(f"Unknown experiment condition {condition!r}.")


def _speaker_order(agent_count: int, item_index: int) -> list[int]:
    """Rotate who opens so speaker position is balanced across a batch."""
    start = item_index % agent_count
    return [(start + turn) % agent_count for turn in range(DEBATE_TURNS)]


def _source_agent_index(item_index: int, agent_count: int, has_context: bool) -> int | None:
    """Balance the context-exposed seat across the batch (not fixed at agent 0)."""
    return item_index % agent_count if has_context else None


def run_debate(
    item: Question,
    agents: list[Agent],
    *,
    context: str | None = None,
    item_index: int = 0,
    return_details: bool = False,
) -> str | DebateResult:
    """Run five sequential turns and aggregate with voting or consensus."""
    prompt_text, all_valid_options = format_question(item)
    valid_options = _answer_options(all_valid_options)
    if not valid_options:
        raise ValueError("This protocol requires a multiple-choice task with answer options.")
    option_texts = normalize_question(item).get("options")
    correct = normalize_question(item).get("correct")
    source_index = _source_agent_index(item_index, len(agents), bool(context))
    order = _speaker_order(len(agents), item_index)
    transcript = ""
    previous_answer = None
    adjacent_matches = 0
    adjacent_comparisons = 0
    source_initial_answer = None

    print(f"Protocol: {len(agents)} neutral agents, {DEBATE_TURNS} sequential turns, {DECISION_PROTOCOL}.")
    if source_index is None:
        print("Context condition: clean (no agent receives extra information).")
    else:
        print(f"Context condition: extra information assigned to Agent {source_index + 1}; speaker order: {[i + 1 for i in order]}")
        print(f"Injected text (verbatim from dataset's 'other' field, unmodified by this script or any model): {context!r}")

    for turn, agent_index in enumerate(order, start=1):
        agent = agents[agent_index]
        is_source_first_turn = source_index == agent_index and source_initial_answer is None
        statement = agent.speak(
            prompt_text,
            transcript,
            valid_options,
            turn,
            private_context=context if is_source_first_turn else None,
        )
        answer = _extract_answer(statement, valid_options, option_texts)
        if previous_answer is not None and answer is not None:
            adjacent_comparisons += 1
            adjacent_matches += answer == previous_answer
        if is_source_first_turn:
            source_initial_answer = answer
        entry = f"[Turn {turn}] {agent.name}: {statement}"
        source_note = "  [CONTEXT-EXPOSED AGENT]" if is_source_first_turn else ""
        answer_note = f"  [stated answer={answer}]" if answer else "  [no parseable stated answer]"
        print(entry + source_note + answer_note)
        transcript += entry + "\n"
        if answer is not None:
            previous_answer = answer

    print("\n--- Final decision ---")
    votes: list[str] = []
    source_final_vote = None
    if DECISION_PROTOCOL == "voting":
        tally = Counter()
        for index, agent in enumerate(agents):
            vote, reason = agent.vote(prompt_text, transcript, valid_options)
            if vote not in valid_options:
                raise ValueError(f"{agent.name} did not produce a valid forced-choice vote: {vote}")
            votes.append(vote)
            tally[vote] += 1
            if index == source_index:
                source_final_vote = vote
            print(f"{agent.name}: {vote} — {reason}")
        winner = tally.most_common(1)[0][0]
        print(f"Tally: {dict(tally)}")
    elif DECISION_PROTOCOL == "consensus":
        winner = previous_answer
        if winner not in valid_options:
            raise ValueError("Consensus failed because the final turn had no parseable answer.")
        print(f"Consensus decision (last stated answer): {winner}")
        if source_index is not None:
            source_final_vote = source_initial_answer
    else:
        raise ValueError(f"Unknown DECISION_PROTOCOL {DECISION_PROTOCOL!r}.")

    recovered = None
    if source_index is not None and correct and source_initial_answer and source_final_vote:
        recovered = source_initial_answer != correct and source_final_vote == correct
        if recovered:
            status = "RECOVERED: initially wrong, final vote correct"
        elif source_initial_answer != correct:
            status = "PERSISTED: initially wrong, final vote still wrong"
        elif source_final_vote != correct:
            status = "LOST: initially correct, final vote wrong"
        else:
            status = "RESISTED: initially and finally correct"
        print(f"Context-exposed agent recovery: initial={source_initial_answer}, final={source_final_vote}, correct={correct} -> {status}")
    if adjacent_comparisons:
        print(f"Answer persistence: {adjacent_matches}/{adjacent_comparisons} adjacent stated answers matched.")
    print(f"Final decision: {winner}")

    result = DebateResult(winner, source_index, source_initial_answer, source_final_vote, recovered, adjacent_matches, adjacent_comparisons)
    return result if return_details else result.winner


def _print_recovery_summary(details: list[DebateResult]) -> None:
    exposed = [item for item in details if item.source_agent_index is not None and item.source_initial_answer]
    initially_wrong = [item for item in exposed if item.source_recovered is not None and item.source_initial_answer != item.source_final_vote or False]
    # The explicit recovered/persisted counts below avoid treating clean items as failures.
    recovered = sum(item.source_recovered is True for item in exposed)
    persistence_matches = sum(item.adjacent_answer_matches for item in details)
    persistence_total = sum(item.adjacent_answer_comparisons for item in details)
    print("\n=== Misinformation-recovery summary ===")
    print(f"Context-exposed items with a parseable initial answer: {len(exposed)}")
    print(f"Recovered after an initially wrong source answer: {recovered}")
    if persistence_total:
        print(f"Adjacent-turn answer persistence: {persistence_matches}/{persistence_total} ({persistence_matches / persistence_total * 100:.1f}%)")


def _choose_condition() -> str:
    choices = {
        "1": "clean",
        "2": "relevant_misinformation",
        "3": "irrelevant_misinformation",
        "4": "irrelevant_true_information",
    }
    print("Context condition: 1) clean  2) relevant misinformation  3) irrelevant misinformation  4) irrelevant true information")
    choice = input(f"Choice [1-4, Enter={EXPERIMENT_CONDITION}]: ").strip()
    return choices.get(choice, EXPERIMENT_CONDITION)


if __name__ == "__main__":
    AZURE_MODEL = choose_azure_model(AZURE_MODEL)
    condition = _choose_condition()
    safe_model = AZURE_MODEL.replace("/", "-").replace("\\", "-")
    log_path = start_logging(f"MINT_{condition}_{DECISION_PROTOCOL}_{safe_model}")
    print(f"(Logging this run to: {log_path})")
    print(f"Model={AZURE_MODEL}; relevant-misinformation field=other (fixed); condition={condition}")
    agents = build_agents()

    mode = input("(1) Single task  (2) MINT batch / JSON batch: ").strip()
    if mode != "2":
        topic = input("Debate task: ").strip()
        run_debate(topic, agents, context=None)
    else:
        path = input("Path to questions JSON file (or 'mint'): ").strip()
        questions = mint_loader.load_questions() if path.lower() == "mint" else load_questions(path)
        if MAX_BATCH_QUESTIONS is not None:
            questions = questions[:MAX_BATCH_QUESTIONS]
        results: list[tuple[Question, str | None]] = []
        details: list[DebateResult] = []
        skipped: list[str] = []
        for index, item in enumerate(questions):
            norm = normalize_question(item)
            label = item.get("mint_id", item.get("id", norm["question"][:40])) if isinstance(item, dict) else norm["question"][:40]
            print(f"\n========== {label} ==========")
            try:
                context = _condition_context(item, condition, questions, index)
                detail = run_debate(item, agents, context=context, item_index=index, return_details=True)
                assert isinstance(detail, DebateResult)
                details.append(detail)
                results.append((item, detail.winner))
            except (ContentFilterError, HTTPError) as error:
                print(f"!! Unscored {label}: {error}")
                results.append((item, None))
                skipped.append(str(label))
            except Exception as error:
                print(f"!! Unscored {label}: {error}")
                results.append((item, None))
                skipped.append(str(label))
            finally:
                time.sleep(QUESTION_DELAY)

        score_batch(results)
        _print_recovery_summary(details)
        if skipped:
            with open("skipped_items.json", "w", encoding="utf-8") as file:
                json.dump(skipped, file, indent=2)
            print(f"Skipped items saved to skipped_items.json ({len(skipped)} total).")