# Secrets — never commit real keys. Only .env.example is tracked.
.env

# Local-only files from the pre-framework pilot (kept on Rishi's machine for
# the record; teammates don't need them and they are never pushed).
# README is also local-only for now: the repo keeps its initial README until
# the project is final and ready for the paper-submission code release.
/README.md
/README.local.md
EXPERIMENT_LOG.md
MINT_INTEGRATION_PROMPT.md
CLAUDE.md
mint_dataset.py
submissions/2026-07-25_qwen/

# Bulky run transcripts (the directory itself is kept via logs/.gitkeep).
logs/*
!logs/.gitkeep

# Downloaded MINT dataset (~7 MB); mint_loader re-fetches it on demand.
# EXCEPTION: the winogrande gold labels are NOT re-fetchable (built once by
# joining allenai/winogrande on sentence text) and scoring is impossible
# without them — they must be tracked so every clone can score runs.
data/*.json
!data/winogrande_labels.json

# Aggregated results are regenerated by `run_experiment.py --analyze-only`.
results/

# Python
__pycache__/
*.pyc

# Virtual environments
.venv/

# macOS
.DS_Store
